# Database Configuration (PostgreSQL / MySQL / SQLite)

# Option A: PostgreSQL Connection (Supabase, Neon, AWS RDS, Local Postgres)
# DB_TYPE=postgres
# DATABASE_URL=postgres://username:password@localhost:5432/seo_tracker
# DB_SSL=false

# Or individual PostgreSQL parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=seo_tracker

# -------------------------------------------------------------

# Option B: MySQL Connection (PlanetScale, AWS RDS, Local MySQL)
# DB_TYPE=mysql
# DATABASE_URL=mysql://root:password@localhost:3306/seo_tracker

# Or individual MySQL parameters:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=seo_tracker

# -------------------------------------------------------------

# Option C: Local SQLite (Default fallback if no DB_TYPE or DATABASE_URL provided)
# DB_TYPE=sqlite

PORT=3001
